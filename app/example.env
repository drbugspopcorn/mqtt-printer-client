DOCUMENT_LOCATION=docs_tmp/
# Shows up in the OMS as despatch/printers/<CLIENT_NAME>/<printer>.  Defaults to the hostname.
CLIENT_NAME=reuben
BASE_CHANNEL=despatch/printers/
FLEET_CHANNEL=despatch/clients/

MQTT_BROKER_ADDRESS=docker-host-esxi.local
MQTT_BROKER_PORT=1883
# MQTT_USERNAME=
# MQTT_PASSWORD=

# cups (default on linux/mac), windows, or mock for testing without printers
# PRINTER_HANDLER=cups
# Which printers are offered to the OMS: usb (physically plugged in, the default) and/or network.
# Network printers still show on the fleet page, they just aren't offered for printing.
# PRINTER_CONNECTIONS=usb
# STATUS_INTERVAL=30
# LOG_LEVEL=INFO
