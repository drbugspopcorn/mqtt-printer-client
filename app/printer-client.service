# Template - install.sh fills in @USER@, @APP_DIR@ and @PYTHON@ and writes it to /etc/systemd/system
[Unit]
Description=Shipping Printer Client.  Waits for MQTT, then prints from mqtt
Wants=network-online.target
After=network-online.target cups.service
Requires=cups.service
# keep restarting forever - the launcher handles rolling back a bad update
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
WorkingDirectory=@APP_DIR@
ExecStart=@PYTHON@ -u @APP_DIR@/launcher.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
